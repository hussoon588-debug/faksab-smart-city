{
  "$comment": "Single source of truth for the deployable web apps in this repository. tools/check.mjs and tools/build.mjs read this file; keep versions in sync with each app's manifest.",
  "apps": [
    {
      "id": "faksab",
      "label": "FAKSAB SMART CITY",
      "version": "8.2.4",
      "root": ".",
      "entry": "index.html",
      "manifest": "manifest.json",
      "serviceWorker": "sw.js",
      "publishedBasePath": "/faksab-smart-city/",
      "requiredFiles": [
        "index.html",
        "manifest.json",
        "sw.js",
        "icon-192.png",
        "icon-512.png"
      ],
      "copy": [
        "index.html",
        "manifest.json",
        "sw.js",
        "icon-192.png",
        "icon-512.png",
        "reset.html",
        "setup.html",
        "vendor",
        "src/supabase-world.js"
      ]
    },
    {
      "id": "ofuq",
      "label": "OFUQ",
      "version": "0.6.0",
      "root": "apps/ofuq",
      "entry": "apps/ofuq/index.html",
      "manifest": "apps/ofuq/manifest.webmanifest",
      "serviceWorker": "apps/ofuq/sw.js",
      "publishedBasePath": "apps/ofuq/",
      "requiredFiles": [
        "index.html",
        "manifest.webmanifest",
        "sw.js",
        "assets/style.css",
        "assets/icon-192.png",
        "assets/icon-512.png",
        "src/main.js",
        "src/config.js",
        "src/core.js",
        "src/store.js",
        "src/ui.js"
      ],
      "copy": [
        "apps/ofuq"
      ]
    }
  ]
}
